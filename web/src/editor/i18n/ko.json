  "templateCode": {
    "flowchart": "flowchart TD\n  A[시작] --> B{조건 충족?}\n  B -- 예 --> C[실행]\n  B -- 아니요 --> D[다른 작업]\n  C --> E[종료]\n  D --> E",
    "sequence": "sequenceDiagram\n  participant A as 클라이언트\n  participant S as 서버\n  A->>S: 요청\n  S-->>A: 응답\n  Note over A,S: 요청 및 응답 완료",
    "class": "classDiagram\n  class Page {\n    +string id\n    +string title\n    +render()\n  }\n  class Space\n  Space \"1\" --> \"*\" Page : 포함",
    "state": "stateDiagram-v2\n  state \"초안\" as Draft\n  state \"게시됨\" as Published\n  state \"보관됨\" as Archived\n  [*] --> Draft\n  Draft --> Published: 게시\n  Published --> Archived: 보관\n  Archived --> [*]",
    "er": "erDiagram\n  SPACE ||--o{ PAGE : \"포함\"\n  PAGE ||--o{ ASSET : \"삽입\"\n  PAGE {\n    string id\n    string title\n  }",
    "gantt": "gantt\n  title 작업 계획\n  dateFormat YYYY-MM-DD\n  section 1단계\n  분석 :a1, 2026-01-05, 7d\n  개발 :after a1, 14d",
    "timeline": "timeline\n  title 프로젝트 연혁\n  2024 : 아이디어 구상\n  2025 : 시제품 : 첫 사용자\n  2026 : 출시",
    "pie": "pie showData\n  title 시간 배분\n  \"개발\" : 45\n  \"검토\" : 25\n  \"회의\" : 30",
    "mindmap": "mindmap\n  root((Folio))\n    페이지\n      마크다운\n      다이어그램\n    공동 작업\n      CRDT\n      커서"
  },
